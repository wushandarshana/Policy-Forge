            for="quote-product"
          >
            Product
          </label>
          <select
            data-testid="product-select"
            id="quote-product"
          >
            <option
              value="TERM_LIFE"
            >
              Term Life
            </option>
            <option
              value="MOTOR"
            >
              Motor
            </option>
            <option
              value="HOUSEHOLD"
            >
              Household
            </option>
          </select>
        </div>
        <div
          class="fields"
        >
          <div
            class="field"
            data-testid="field-age"
          >
            <label
              for="quote-input-age"
            >
