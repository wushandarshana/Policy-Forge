            data-testid="field-termYears"
          >
            <label
              for="quote-input-termYears"
            >
              Term (years)
            </label>
            <select
              data-testid="input-termYears"
              id="quote-input-termYears"
            >
              <option
                value="10"
              >
                10
              </option>
              <option
                value="20"
              >
                20
              </option>
              <option
                value="30"
              >
                30
              </option>
            </select>
          </div>
          <div
            class="field"
            data-testid="field-bmi"
          >
            <label
              for="quote-input-bmi"
            >
              BMI
            </label>
            <input
              autocomplete="off"
              data-testid="input-bmi"
              id="quote-input-bmi"
              inputmode="decimal"
              placeholder="24.5"
              type="text"
              value=""
            />
          </div>
          <div
            class="field"
            data-testid="field-healthDeclarations"
          >
            <label
              for="quote-input-healthDeclarations"
            >
              Health declarations — upper-case codes, comma separated, max 10 (e.g. DIABETES)
