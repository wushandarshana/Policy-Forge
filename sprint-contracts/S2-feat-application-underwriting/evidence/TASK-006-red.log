              data-testid="input-age"
              id="quote-input-age"
              inputmode="numeric"
              max="65"
              min="18"
              step="1"
              type="number"
              value=""
            />
          </div>
          <div
            class="field field-boolean"
            data-testid="field-smoker"
          >
            <label
              for="quote-input-smoker"
            >
              Smoker
