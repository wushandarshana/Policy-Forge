            <input
              data-testid="input-smoker"
              id="quote-input-smoker"
              type="checkbox"
            />
          </div>
          <div
            class="field"
            data-testid="field-sumInsured"
          >
            <label
              for="quote-input-sumInsured"
            >
              Sum insured
            </label>
            <input
              autocomplete="off"
              data-testid="input-sumInsured"
              id="quote-input-sumInsured"
              inputmode="decimal"
              placeholder="5000000.00"
              type="text"
              value=""
            />
          </div>
          <div
